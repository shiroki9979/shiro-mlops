# ==============================================================================
# Shiro MLOps Platform Environment Configuration Example (.env.example)
# Copy this file to .env and adjust variables as needed for your environment.
# ==============================================================================

# Environment mode: local | aws | test
ENVIRONMENT=local

# Storage & AWS Configuration
DATA_DIR=data
S3_BUCKET_NAME=shiro-mlops-artifacts
AWS_REGION=ap-northeast-1

# Feast Offline Store: file (local DATA_DIR) | s3
FEAST_OFFLINE_STORE_TYPE=file
FEAST_S3_PREFIX=features

# TimescaleDB / Operational Time-Series Database
TIMESCALE_HOST=localhost
TIMESCALE_PORT=5432
TIMESCALE_DB=shiro_timeseries
TIMESCALE_USER=postgres
TIMESCALE_PASSWORD=postgrespassword


# Redis / Feast Online Feature Store
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# MLflow Tracking Server
MLFLOW_TRACKING_URI=http://localhost:5001

# Feast Feature Store Path
FEAST_REPO_PATH=src/shiro_mlops/features

# External Open Data APIs
# CWA OpenData 授權碼；請填入本機 .env，勿提交實際密鑰。
CWA_API_KEY=
# Optional JSON object overriding the Taipei/Taichung/Kaohsiung defaults.
CWA_LOCATION_ALLOWLIST=
TAIPOWER_SUPPLY_DEMAND_API_URL=https://service.taipower.com.tw/data/opendata/apply/file/d006020/001.json
TAIPOWER_REGIONAL_SUPPLY_DEMAND_API_URL=https://service.taipower.com.tw/data/opendata/apply/file/d006019/001.csv
TAIPOWER_UNIT_GENERATION_API_URL=https://service.taipower.com.tw/data/opendata/apply/file/d006001/001.json

# Nationwide hourly actual load derived from regional snapshots (ADR-0008)
# Minimum valid 10-minute samples per hour (at most 6); hours below it stay missing.
HOURLY_LOAD_MIN_SAMPLES=4
# Completed hours recomputed by each hourly_actual_load_job run to absorb late samples.
HOURLY_LOAD_RECOMPUTE_HOURS=3
# The training accumulation threshold and stale load anchor lag are task policies, not
# environment variables: see [policies] in src/shiro_mlops/tasks/dynamic_horizon_forecast.toml.
# Trained models live in DATA_DIR/models/<task_id>/; a legacy DATA_DIR/model.joblib is ignored.

# FastAPI Serving
API_HOST=0.0.0.0
API_PORT=8000
# Trusted-network Data Explorer. Always on when ENVIRONMENT=local; set true to enable elsewhere.
DATA_EXPLORER_ENABLED=false
