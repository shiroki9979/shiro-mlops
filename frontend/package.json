{
    "name": "shiro-mlops-frontend",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "packageManager": "pnpm@11.24.0",
    "engines": {
        "node": "24.19.0"
    },
    "scripts": {
        "dev": "pnpm --parallel --filter './apps/*' run dev",
        "build": "pnpm --filter @shiro-mlops/shared run typecheck && pnpm --filter './apps/*' run build",
        "lint": "eslint .",
        "test": "pnpm --recursive run test"
    },
    "devDependencies": {
        "@eslint/js": "^9.20.0",
        "eslint": "^9.20.1",
        "eslint-plugin-react-hooks": "^5.1.0",
        "eslint-plugin-react-refresh": "^0.4.19",
        "globals": "^15.15.0",
        "typescript": "~5.7.3",
        "typescript-eslint": "^8.24.0"
    }
}
