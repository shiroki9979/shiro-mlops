FROM python:3.11-slim

WORKDIR /app

# 版本與 uv.lock 一致，讓 tracking server 與專案的 MLflow client 同版。SQLAlchemy 須同時鎖定：
# 2.1 起 postgresql:// 的預設 driver 改為 psycopg（v3），未安裝即讓容器持續重啟（#205）。
RUN pip install --no-cache-dir mlflow==3.15.1 psycopg2-binary==2.9.12 sqlalchemy==2.0.52

EXPOSE 5000

ENV BACKEND_STORE_URI=sqlite:///mlflow.db
ENV ARTIFACT_ROOT=/mlflow/artifacts

CMD mlflow server \
    --backend-store-uri ${BACKEND_STORE_URI} \
    --default-artifact-root ${ARTIFACT_ROOT} \
    --host 0.0.0.0 \
    --port 5000
