FROM python:3.11-slim

WORKDIR /app

# SYNC(uv.lock): tracking server stays on the project's MLflow client and SQLAlchemy versions;
# unpinned installs broke the image when SQLAlchemy 2.1 changed its default Postgres driver (#205).
RUN pip install --no-cache-dir mlflow==3.15.1 psycopg2-binary==2.9.12 sqlalchemy==2.0.52

EXPOSE 5000

ENV BACKEND_STORE_URI=sqlite:///mlflow.db
ENV ARTIFACT_ROOT=/mlflow/artifacts

CMD mlflow server \
    --backend-store-uri ${BACKEND_STORE_URI} \
    --default-artifact-root ${ARTIFACT_ROOT} \
    --host 0.0.0.0 \
    --port 5000
