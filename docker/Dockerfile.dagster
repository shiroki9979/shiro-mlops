FROM python:3.11-slim

WORKDIR /workspace

# LightGBM 的 native lib 依賴 OpenMP runtime
RUN apt-get update \
    && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:latest /uv /bin/uv

COPY pyproject.toml README.md ./
COPY src/ ./src/

# 依賴版本取自 uv.lock：未鎖版時重建會解析到新版（例如 SQLAlchemy 2.1 改變 postgresql:// 的預設驅動）。
COPY uv.lock ./
COPY lab/pyproject.toml ./lab/
RUN uv export --frozen --no-dev --no-emit-workspace --package shiro-mlops -o /tmp/requirements.txt \
    && uv pip install --system -r /tmp/requirements.txt \
    && uv pip install --system --no-deps -e .

ENV DAGSTER_HOME=/dagster_home
RUN mkdir -p /dagster_home

EXPOSE 3000

CMD ["dagster", "dev", "-h", "0.0.0.0", "-p", "3000", "-f", "src/shiro_mlops/pipelines/definitions.py"]
